APP_NAME=ScoutLead
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_URL=${{Postgres.DATABASE_URL}}
PORT=8000
AUTO_CREATE_TABLES=false
API_AUTH_TOKEN=replace-with-long-random-token
CORS_ORIGINS=https://replace-with-railway-web-domain.up.railway.app

ALLOW_MOCK_PROVIDERS=false
REQUIRE_REAL_SEARCH=true
REQUIRE_REAL_EMAIL=true
REQUIRE_REAL_LLM=true

SEARCH_PROVIDER=tavily
SEARCH_API_ENDPOINT=
SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
APIFY_API_TOKEN=
# Each Apify source is one APIFY_SOURCE_<NAME> JSON object.
APIFY_SOURCE_KIJIJI={"id":"kijiji","label":"Kijiji","enabled":true,"actor_id":"actor-owner/kijiji-actor","detail":"Classified service listings","input_kind":"text_query","input_template":{"query":"{{query}}","maxResults":"{{limit}}"}}
APIFY_SOURCE_HOMESTARS={"id":"homestars","label":"HomeStars","enabled":true,"actor_id":"actor-owner/homestars-actor","detail":"Canadian home-service reviews","input_kind":"text_query","input_template":{"query":"{{query}}","maxResults":"{{limit}}"}}

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

EMAIL_PROVIDER=gmail
EMAIL_PROVIDER_ENDPOINT=
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ScoutLead
EMAIL_REPLY_TO=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api-service.example.com/email/gmail/callback
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1

CONTACT_VERIFICATION_PROVIDER=bouncer
BOUNCER_API_KEY=
BOUNCER_API_ENDPOINT=
EMAIL_VERIFICATION_ENDPOINT=
EMAIL_VERIFICATION_API_KEY=
ZEROBOUNCE_API_KEY=
ZEROBOUNCE_API_ENDPOINT=
