APP_NAME=soutlead
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_URL=${{Postgres.DATABASE_URL}}
PORT=8000
AUTO_CREATE_TABLES=false
API_AUTH_TOKEN=replace-with-long-random-token
CORS_ORIGINS=https://replace-with-railway-web-domain.up.railway.app

ALLOW_MOCK_PROVIDERS=false
REQUIRE_REAL_SEARCH=true
REQUIRE_REAL_EMAIL=true
REQUIRE_REAL_LLM=true

SEARCH_PROVIDER=tavily
SEARCH_API_ENDPOINT=
SEARCH_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

EMAIL_PROVIDER=resend
EMAIL_PROVIDER_ENDPOINT=
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Soutlead
EMAIL_REPLY_TO=
