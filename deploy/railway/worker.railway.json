{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "/Dockerfile",
      "/.dockerignore",
      "/agent/**",
      "/pyproject.toml",
      "/alembic.ini",
      "/deploy/railway/worker.railway.json",
      "/scripts/start_railway_service.py",
      "/scripts/apply_railway_service_config.py",
      "/scripts/railway_up_ci.py"
    ]
  },
  "deploy": {
    "startCommand": "python scripts/start_railway_service.py"
  }
}
