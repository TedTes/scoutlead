APP_NAME=ScoutLead
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_URL=${{Postgres.DATABASE_URL}}
PYTHONPATH=agent
AUTO_CREATE_TABLES=false
API_AUTH_TOKEN=replace-with-long-random-token
CORS_ORIGINS=https://replace-with-web-service-domain.up.railway.app
ALLOW_MOCK_PROVIDERS=false
REQUIRE_REAL_SEARCH=true
REQUIRE_REAL_EMAIL=true
REQUIRE_REAL_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SEARCH_PROVIDER=tavily
SEARCH_API_ENDPOINT=
SEARCH_API_KEY=
EMAIL_PROVIDER=gmail
EMAIL_PROVIDER_ENDPOINT=
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ScoutLead
EMAIL_REPLY_TO=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://replace-with-api-service-domain.up.railway.app/email/gmail/callback
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
CONTACT_VERIFICATION_PROVIDER=bouncer
BOUNCER_API_KEY=
BOUNCER_API_ENDPOINT=
EMAIL_VERIFICATION_ENDPOINT=
EMAIL_VERIFICATION_API_KEY=
ZEROBOUNCE_API_KEY=
ZEROBOUNCE_API_ENDPOINT=
