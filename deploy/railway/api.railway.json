{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/agent/**",
      "/pyproject.toml",
      "/alembic.ini",
      "/deploy/railway/api.railway.json",
      "/scripts/apply_railway_service_config.py",
      "/scripts/railway_up_ci.py"
    ]
  },
  "deploy": {
    "startCommand": "PYTHONPATH=agent python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
