{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/web/**",
      "/deploy/railway/web.railway.json",
      "/scripts/apply_railway_service_config.py",
      "/scripts/railway_up_ci.py"
    ]
  },
  "deploy": {
    "startCommand": "npm run preview -- --host 0.0.0.0 --port ${PORT:-4173}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
