APP_NAME=soutlead
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=
PORT=8000
AUTO_CREATE_TABLES=true
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional integrations.
ALLOW_MOCK_PROVIDERS=true
REQUIRE_REAL_SEARCH=false
REQUIRE_REAL_EMAIL=false
REQUIRE_REAL_LLM=false
SEARCH_PROVIDER=generic
SEARCH_API_ENDPOINT=
SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
APIFY_API_TOKEN=
# Each Apify source is one APIFY_SOURCE_<NAME> JSON object.
# The <NAME> suffix must match the object id, so APIFY_SOURCE_KIJIJI maps to id "kijiji".
# Template values include {{query}}, {{business_category}}, {{business_slug}}, {{location}},
# {{location_slug}}, {{city}}, {{region}}, {{country}}, {{limit}}, and {{source_url}}.
APIFY_SOURCE_KIJIJI={"id":"kijiji","label":"Kijiji","enabled":true,"actor_id":"actor-owner/kijiji-actor","detail":"Classified service listings","input_kind":"text_query","input_template":{"query":"{{query}}","maxResults":"{{limit}}"}}
APIFY_SOURCE_HOMESTARS={"id":"homestars","label":"HomeStars","enabled":true,"actor_id":"actor-owner/homestars-actor","detail":"Canadian home-service reviews","input_kind":"text_query","input_template":{"query":"{{query}}","maxResults":"{{limit}}"}}
LLM_JSON_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMAIL_PROVIDER=console
EMAIL_PROVIDER_ENDPOINT=
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Soutlead
EMAIL_REPLY_TO=
