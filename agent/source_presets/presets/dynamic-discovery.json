{
  "id": "dynamic-discovery",
  "name": "Dynamic staged discovery",
  "description": "Run a backend-planned set of discovery providers in priority order.",
  "sources": [
    {
      "slot": "discovery",
      "provider_id": "{{provider_id}}",
      "mode": "accumulate",
      "input": {
        "query": "{{query}}",
        "source_type": "{{source_type}}",
        "geography": "{{geography}}",
        "business_category": "{{business_category}}",
        "location": "{{location}}",
        "search_queries": "{{search_queries}}",
        "website_policy": "{{website_policy}}",
        "source_request_prompt": "{{source_request_prompt}}",
        "source_request_source": "{{source_request_source}}"
      },
      "config": {
        "limit": "{{limit}}",
        "stage": "{{stage}}",
        "search_queries": "{{search_queries}}",
        "website_policy": "{{website_policy}}",
        "region_code": "{{region_code}}",
        "actor_input": "{{actor_input}}",
        "result_mapping": "{{result_mapping}}"
      },
      "priority": 0,
      "enabled": true
    }
  ]
}
