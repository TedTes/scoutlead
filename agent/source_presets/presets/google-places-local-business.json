{
  "id": "google-places-local-business",
  "name": "Google Places local business",
  "description": "Use Google Places Text Search to discover real local businesses for service-business validation campaigns.",
  "sources": [
    {
      "slot": "discovery",
      "provider_id": "google_places",
      "mode": "accumulate",
      "input": {
        "query": "{{query}}",
        "geography": "{{geography}}",
        "source_selection": "{{source_selection}}",
        "source_selection_reason": "{{source_selection_reason}}",
        "source_request_prompt": "{{source_request_prompt}}",
        "source_request_action": "{{source_request_action}}",
        "source_request_source": "{{source_request_source}}",
        "source_request_intent": "{{source_request_intent}}"
      },
      "config": {
        "limit": "{{limit}}",
        "region_code": "{{region_code}}",
        "compiled_provider_input": "{{compiled_provider_input}}",
        "include_pure_service_area_businesses": true
      },
      "priority": 10,
      "enabled": true
    }
  ]
}
