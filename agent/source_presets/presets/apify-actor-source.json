{
  "id": "apify-actor-source",
  "name": "Configured listing source",
  "description": "Run the configured listing site. The source name, input template, and output mapping are configured outside the workflow.",
  "sources": [
    {
      "slot": "discovery",
      "provider_id": "{{source_provider_id}}",
      "mode": "accumulate",
      "input": {
        "query": "{{query}}",
        "source_selection": "{{source_selection}}",
        "source_selection_reason": "{{source_selection_reason}}",
        "source_request_prompt": "{{source_request_prompt}}",
        "source_request_action": "{{source_request_action}}",
        "source_request_source": "{{source_request_source}}",
        "source_request_intent": "{{source_request_intent}}"
      },
      "config": {
        "limit": "{{limit}}",
        "actor_input": "{{actor_input}}",
        "compiled_provider_input": "{{compiled_provider_input}}",
        "result_mapping": "{{result_mapping}}"
      },
      "priority": 10,
      "enabled": true
    }
  ]
}
