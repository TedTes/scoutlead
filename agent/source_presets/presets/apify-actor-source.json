{
  "id": "apify-actor-source",
  "name": "Configured Apify actor source",
  "description": "Run a configured Apify actor as a discovery source. The actor, source name, input template, and output mapping are configured outside the workflow.",
  "sources": [
    {
      "slot": "discovery",
      "provider_id": "{{source_provider_id}}",
      "mode": "accumulate",
      "input": {
        "query": "{{query}}",
        "source_selection": "{{source_selection}}",
        "source_selection_reason": "{{source_selection_reason}}",
        "source_request_prompt": "{{source_request_prompt}}",
        "source_request_action": "{{source_request_action}}",
        "source_request_source": "{{source_request_source}}"
      },
      "config": {
        "limit": "{{limit}}"
      },
      "priority": 10,
      "enabled": true
    }
  ]
}
