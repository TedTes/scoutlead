FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/agent \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    SCOUTLEAD_SERVICE=worker

WORKDIR /app

COPY pyproject.toml alembic.ini ./
COPY agent ./agent
COPY data/seeds/canonical-trade-catalog.json ./data/seeds/canonical-trade-catalog.json
COPY scripts/start_railway_service.py ./scripts/start_railway_service.py

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir ".[website-capture]" \
    && python -m playwright install --with-deps chromium

CMD ["python", "scripts/start_railway_service.py"]
